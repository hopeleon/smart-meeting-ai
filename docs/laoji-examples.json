{
  "metadata": {
    "feature": "老记",
    "description": "一句话代办与智能日历输入输出样例",
    "base_date": "2026-07-02",
    "timezone": "Asia/Shanghai",
    "notes": [
      "样例以 2026-07-02 为当前日期。",
      "实际 title 可能受规则解析或本地大模型解析影响略有差异。",
      "parse_source 可为 rules、local_llm 或 clarified。",
      "短语音转写通过 /api/laoji/asr/transcribe 完成，返回文本会先做老记唤醒词同音归一化。",
      "老纪、老计、老季、牢记、小记等句首唤醒词会归一为老记。"
    ]
  },
  "cases": [
    {
      "id": "laoji_once_meeting_with_description",
      "category": "明确日期时间",
      "input": "老记老记，下周三下午两点和周总开会，要讨论硬件相关问题",
      "expected": {
        "title": "周总开会",
        "event_type": "once",
        "start_date": "2026-07-08",
        "start_time": "14:00",
        "end_time": "15:00",
        "is_all_day": false,
        "description": "硬件相关问题",
        "parse_source": "rules",
        "needs_clarification": false
      }
    },
    {
      "id": "laoji_tomorrow_report",

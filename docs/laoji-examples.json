      }
    },
    {
      "id": "laoji_one_shot_asr_transcribe",
      "category": "轻量 ASR 转写",
      "endpoint": "POST /api/laoji/asr/transcribe",
      "audio_input": {
        "format": "wav",
        "sample_rate": 16000,
        "channels": 1,
        "encoding": "pcm_s16le",
        "transport": "base64"
      },
      "expected": {
        "provider": "funasr",
        "text_example": "老记老记，下周三下午两点和周总开会，要讨论硬件相关问题",
        "post_process": [
          "去除首尾空白",
          "归一化老记同音唤醒词",
          "写入主输入框或追问补充框"
        ]
      }
    },
    {
      "id": "laoji_all_day_confirm",
      "category": "全天确认",
      "input": "老记老记，7月31日找财务确认报销",
      "expected": {
        "title": "找财务确认报销",
        "event_type": "once",
        "start_date": "2026-07-31",
        "start_time": null,
        "end_time": null,
        "is_all_day": true,
        "needs_clarification": true
      },
      "clarification": {
        "answer": "就按7月31日全天",
        "expected_after_clarify": {
          "start_date": "2026-07-31",
          "start_time": null,
          "end_time": null,
          "is_all_day": true,
          "parse_source": "clarified",
          "needs_clarification": false
        }
      }
    },
    {
      "id": "laoji_conflict_reference",
      "category": "冲突提示",
      "preexisting_events": [
        {
          "title": "项目周会",
          "start_date": "2026-07-08",
          "start_time": "14:00",
          "end_time": "15:00",
          "is_all_day": false
        }
      ],
      "input": "老记老记，下周三下午两点和周总开会",
      "expected": {
        "start_date": "2026-07-08",
        "start_time": "14:00",
        "end_time": "15:00",
        "conflict_hint": true,
        "conflict_message": "这个时间附近已有安排"
      }
    },
    {
      "id": "laoji_voice_clarification_flow",
      "category": "语音补充流程",
      "steps": [
        {
          "action": "record_command",
          "spoken": "老记老记，月底前找财务确认报销的事",
          "target": "主输入框",
          "asr_mode": "one_shot_funasr"
        },
        {
          "action": "parse",
          "result": "进入需确认状态"
        },
        {
          "action": "record_clarification",
          "spoken": "7月25日下午三点",
          "target": "追问补充框",
          "asr_mode": "one_shot_funasr"
        },
        {
          "action": "apply_clarification",
          "expected": {
            "start_date": "2026-07-25",
            "start_time": "15:00",
            "end_time": "16:00",
            "needs_clarification": false
          }
        }
      ]
    }
  ],

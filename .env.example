# ── 数据库 ────────────────────────────
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting123
POSTGRES_DB=meeting_platform
DATABASE_URL=postgresql+asyncpg://meeting:meeting123@postgres:5432/meeting_platform

# ── Redis ─────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── 模型服务地址 ──────────────────────
ASR_SERVICE_URL=http://asr-stub:8001
DIARIZATION_SERVICE_URL=http://diarization-stub:8002
LLM_SUMMARY_SERVICE_URL=http://llm-summary-stub:8003

# ── 文件存储 ──────────────────────────
AUDIO_STORAGE_PATH=/app/audio_files
# S3_BUCKET=meeting-audio
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ── 应用配置 ──────────────────────────
ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost","http://localhost:5173"]

# ── 前端 ──────────────────────────────
VITE_API_BASE_URL=http://localhost/api
VITE_WS_BASE_URL=ws://localhost/ws
VITE_MOCK_MODE=true

# ── 本地 ASR 模型路径（Docker 容器内 /app/models/）────────────────────
# 容器内路径，与 docker-compose.yml 的 volumes 挂载对应
# 本地开发时需将 ./models 目录挂载到 /app/models
# FunASR 模型（Paraformer-large + 内置 VAD）
FUNASR_MODEL_DIR=/app/models/funasr
# FunASR 标点恢复模型（ct-punc）
PUNC_MODEL_DIR=/app/models/funasr
# CAM++ 中文声纹模型
CAMPPLUS_MODEL_DIR=/app/models/campplus/zh-cn
# CAM++ 英文声纹模型
CAMPPLUS_EN_MODEL_DIR=/app/models/campplus/en
# 本地模型根目录（用于 Silero VAD 等）
LOCAL_MODEL_DIR=/app/models
# 推理设备：cuda 或 cpu
LOCAL_DEVICE=cuda
